MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=dr_screening
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=10
AUTH_SECRET=your_nextauth_secret_here

